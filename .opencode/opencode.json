{
    "$schema": "https://opencode.ai/config.json",
    "formatter": {
        "ruff": {
            "command": [
                "just",
                "format-file",
                "$FILE"
            ],
            "extensions": [
                ".py",
                ".pyi"
            ]
        }
    },
    "lsp": {
        "pyright": {
            "command": [
                "just",
                "pyright-lsp"
            ],
            "extensions": [
                ".py",
                ".pyi"
            ]
        }
    },
    "permission": {
        "bash": {
            "just lint*": "allow",
            "just format*": "allow",
            "just typecheck*": "allow",
            "just test*": "allow",
            "just check*": "allow"
        }
    }
}