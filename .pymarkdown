{
  "plugins": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD007": { "indent": 4 },
    "MD013": { "line_length": 100, "code_blocks": false, "tables": false, "headings": false, "heading_line_length": 200, "table_line_length": 200, "enabled": false },
    "MD024": { "siblings_only": true },
    "MD029": { "enabled": false },
    "MD046": { "style": "fenced" }
  },
  "log": { "level": "WARNING" },
  "strict": true
}
