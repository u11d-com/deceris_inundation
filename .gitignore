# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# uv / venv — uv.lock IS committed (frozen builds); venv lives in the
# Docker image, never on host.
.venv/
.ruff_cache/
.pyright_cache/

# Build / runtime artifacts
*.sif
*.parquet
*.npz
.tmp/

# Benchmark output directory (kept under deceris/inundation/ for legacy path
# compatibility — .rsync-ignore also excludes it for remote rsync workflows).
deceris/inundation/results/

# qmd local SQLite index. Config (index.yml) is committed — project-scoped
# config uses relative paths. The .sqlite is rebuilt locally via
# `qmd update` + `qmd embed`.
.qmd/*.sqlite*

.DS_Store

# Published UK Environment Agency 2D benchmark datasets (May-2010 distribution).
# Not redistributed here; EA Tests 2/3/4 read them from this path. Obtain the
# archive separately and unpack it as Benchmarking_Model_Data/ to run those
# benchmarks (`just benchmark-depressions|obstruction|propagation`).
Benchmarking_Model_Data/
