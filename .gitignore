# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# uv / venv — uv.lock IS committed (frozen builds); venv lives in the
# Docker image, never on host.
.venv/
.ruff_cache/
.pyright_cache/

# Build / runtime artifacts
*.sif
*.parquet
*.npz
.tmp/

# Benchmark output directory (kept under inundation/ for the benchmark
# recipes; also excluded from remote sync workflows).
inundation/results/

# qmd local SQLite index. Config (index.yml) is committed — project-scoped
# config uses relative paths. The .sqlite is rebuilt locally via
# `qmd update` + `qmd embed`.
.qmd/*.sqlite*

.DS_Store

# Published UK Environment Agency 2D benchmark datasets (May-2010
# distribution). The seven EA Test 2/3/4 inputs used by this repository are
# tracked under benchmark_assets/. Keep this ignore for the optional external
# archive only.
Benchmarking_Model_Data/
